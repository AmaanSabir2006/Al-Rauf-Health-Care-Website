# Al Rauf Health Care - Environment Template
# Copy this file to .env.local and fill in your actual credentials

# Supabase Credentials (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Clinic Reception Security Password
RECEPTION_PIN=your_reception_desk_password

# HMAC Secret for Session Token Verification
HMAC_SECRET=your_hmac_secret_key_here
